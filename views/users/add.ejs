<%- include('../partials/header', {title: title}) %>
<div class="app-container">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <header class="topbar">
      <div class="topbar-left">
        <h1>Ajouter un Utilisateur</h1>
        <p>Créer un compte avec un rôle</p>
      </div>
      <div class="topbar-right">
        <a href="/users" class="btn" style="background:#64748b;color:white"><i class="fas fa-arrow-left"></i> Retour</a>
      </div>
    </header>

    <div class="panel" style="max-width:700px">
      <div class="panel-header">
        <h3><i class="fas fa-user-plus"></i> Informations</h3>
      </div>
      <div style="padding:30px">
        <form action="/users/ajouter" method="POST">
          <div class="grid-2">
            <div class="form-group">
              <label>Nom *</label>
              <input type="text" name="nom" required>
            </div>
            <div class="form-group">
              <label>Prénom *</label>
              <input type="text" name="prenom" required>
            </div>
          </div>
          <div class="form-group">
            <label>Nom d'utilisateur *</label>
            <input type="text" name="username" required>
          </div>
          <div class="grid-2">
            <div class="form-group">
              <label>Email</label>
              <input type="email" name="email">
            </div>
            <div class="form-group">
              <label>Téléphone</label>
              <input type="text" name="telephone">
            </div>
          </div>
          <div class="form-group">
            <label>Rôle *</label>
            <select name="role" required>
              <option value="vendeur">Vendeur</option>
              <option value="caissier">Caissier</option>
              <option value="livreur">Livreur</option>
              <option value="manager">Manager</option>
              <option value="admin">Administrateur</option>
            </select>
          </div>
          <div class="form-group">
            <label>Mot de passe *</label>
            <input type="password" name="password" required>
          </div>
          <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Créer l'utilisateur</button>
        </form>
      </div>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>
