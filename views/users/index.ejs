<%- include('../partials/header', {title: title}) %>
<div class="app-container">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <header class="topbar">
      <div class="topbar-left">
        <h1>Gestion des Utilisateurs</h1>
        <p>Administration des comptes et rôles</p>
      </div>
      <div class="topbar-right">
        <a href="/users/ajouter" class="btn btn-primary"><i class="fas fa-user-plus"></i> Ajouter un Utilisateur</a>
      </div>
    </header>

    <div class="panel">
      <div class="panel-header">
        <h3><i class="fas fa-users-cog"></i> Liste des Utilisateurs</h3>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Nom d'utilisateur</th>
              <th>Nom & Prénom</th>
              <th>Email</th>
              <th>Téléphone</th>
              <th>Rôle</th>
              <th>Statut</th>
              <th>Dernière Connexion</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if(users && users.length > 0) { %>
              <% users.forEach(u => { %>
                <tr>
                  <td><strong><%= u.username %></strong></td>
                  <td><%= u.prenom %> <%= u.nom %></td>
                  <td><%= u.email || '-' %></td>
                  <td><%= u.telephone || '-' %></td>
                  <td><span class="badge badge-info"><%= u.role.toUpperCase() %></span></td>
                  <td>
                    <% if(u.actif) { %>
                      <span class="badge badge-success">Actif</span>
                    <% } else { %>
                      <span class="badge badge-danger">Inactif</span>
                    <% } %>
                  </td>
                  <td><%= u.derniereConnexion ? u.derniereConnexion.toLocaleString('fr-FR') : '-' %></td>
                  <td>
                    <div class="actions">
                      <a href="/users/modifier/<%= u._id %>" class="btn btn-warning" style="padding:6px 10px"><i class="fas fa-edit"></i></a>
                      <% if(u._id.toString() !== user.id) { %>
                        <form action="/users/supprimer/<%= u._id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirm('Supprimer cet utilisateur?')">
                          <button class="btn btn-danger" style="padding:6px 10px"><i class="fas fa-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="8" style="text-align:center;padding:40px">Aucun utilisateur</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>
