<%- include('../partials/header', {title: title}) %>
<div class="app-container">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <header class="topbar">
      <div class="topbar-left">
        <h1>Détail du Bénéfice du Mois</h1>
        <p>Origine de chaque marge</p>
      </div>
      <div class="topbar-right">
        <a href="/rapports" class="btn" style="background:#64748b;color:white"><i class="fas fa-arrow-left"></i> Retour</a>
      </div>
    </header>

    <div class="panel">
      <div class="panel-header">
        <h3><i class="fas fa-list"></i> Détail par ligne</h3>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>N° Facture</th>
              <th>Article</th>
              <th>Quantité</th>
              <th>Prix Vente</th>
              <th>Prix Achat</th>
              <th>Marge Unitaire</th>
              <th>Marge Totale</th>
            </tr>
          </thead>
          <tbody>
            <% if(details && details.length > 0) { %>
              <% details.forEach(d => { %>
                <tr>
                  <td><%= d.facture %></td>
                  <td><%= d.article %></td>
                  <td><%= d.quantite %></td>
                  <td><%= d.prixVente.toLocaleString() %> UM</td>
                  <td><%= d.prixAchat.toLocaleString() %> UM</td>
                  <td><%= (d.prixVente - d.prixAchat).toLocaleString() %> UM</td>
                  <td><strong style="color:#16a34a"><%= d.marge.toLocaleString() %> UM</strong></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="7" style="text-align:center;padding:40px">Aucun détail</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>
