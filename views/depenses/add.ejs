<%- include('../partials/header', {title: title}) %>
<div class="app-container">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <header class="topbar">
      <div class="topbar-left">
        <h1>Ajouter une Dépense</h1>
      </div>
      <div class="topbar-right">
        <a href="/depenses" class="btn" style="background:#64748b;color:white"><i class="fas fa-arrow-left"></i> Retour</a>
      </div>
    </header>

    <div class="panel" style="max-width:700px">
      <div class="panel-header">
        <h3><i class="fas fa-plus"></i> Nouvelle Dépense</h3>
      </div>
      <div style="padding:30px">
        <form action="/depenses/ajouter" method="POST">
          <div class="form-group">
            <label>Libellé *</label>
            <input type="text" name="libelle" required>
          </div>
          <div class="grid-2">
            <div class="form-group">
              <label>Catégorie *</label>
              <select name="categorie" required>
                <option value="SALAIRE">Salaire</option>
                <option value="LOYER">Loyer</option>
                <option value="ELECTRICITE">Électricité</option>
                <option value="EAU">Eau</option>
                <option value="ACHAT_DIVERS">Achat divers</option>
                <option value="TRANSPORT">Transport</option>
                <option value="REPARATION">Réparation</option>
                <option value="AUTRE">Autre</option>
              </select>
            </div>
            <div class="form-group">
              <label>Montant (FCFA) *</label>
              <input type="number" name="montant" min="0" required>
            </div>
          </div>
          <div class="grid-2">
            <div class="form-group">
              <label>Bénéficiaire</label>
              <input type="text" name="beneficiaire">
            </div>
            <div class="form-group">
              <label>Mode de Paiement</label>
              <select name="modePaiement">
                <option value="ESPECES">Espèces</option>
                <option value="MOBILE_MONEY">Mobile Money</option>
                <option value="CARTE">Carte</option>
                <option value="CHEQUE">Chèque</option>
                <option value="AUTRE">Autre</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label>Date</label>
            <input type="date" name="dateDepense">
          </div>
          <div class="form-group">
            <label>Observations</label>
            <textarea name="observations" rows="2"></textarea>
          </div>
          <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Enregistrer</button>
        </form>
      </div>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>
